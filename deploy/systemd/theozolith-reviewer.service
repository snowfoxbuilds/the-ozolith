# Optional systemd unit for the Reviewer driver (daemon-less dev shape).
# From M3 on the deployment contract is the Node Daemon supervising this
# driver as a process-kind Stack (theozolith-nodedaemon.service, cgroup
# kill-the-tree; ADR-0013) — this standalone unit remains a convenience.
#
#   sudo cp deploy/systemd/theozolith-reviewer.service /etc/systemd/system/
#   sudo systemctl edit theozolith-reviewer   # set User= and the paths below
#   sudo systemctl enable --now theozolith-reviewer

[Unit]
Description=TheOzolith Reviewer driver (poll pr_ready PRs, run review containers)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ozolith
EnvironmentFile=/etc/theozolith/.env
ExecStart=/usr/local/bin/theozolith-driver builtin:reviewer
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
