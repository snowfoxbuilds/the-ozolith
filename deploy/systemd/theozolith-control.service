# TheOzolith Control Node (ADR-0034). `sudo theozolith init` installs and
# enables this unit with the real ExecStart path and external port filled
# in; this copy documents the shape. The service binds the external https
# port (default 443) directly as an unprivileged dedicated user — the
# capability grant below is the whole privilege story: no root serve, no
# setcap on a shared interpreter.

[Unit]
Description=TheOzolith Control Node
After=network-online.target
Wants=network-online.target

[Service]
User=ozolith-control
Group=ozolith-control
Environment=THEOZOLITH_DATA_DIR=/var/lib/theozolith-control
ExecStart=/usr/local/bin/theozolith serve --port 443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
