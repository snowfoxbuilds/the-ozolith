# TheOzolith M2 deployment: one Worker + the Reviewer on one box.
# Copy to .env and fill in. Any secret below may instead be provided as
# <NAME>_FILE pointing at a file mounted into the container (the VAR_FILE
# convention every TheOzolith service honors; NODE-SUBSTRATE.md).

# --- required ---------------------------------------------------------------

# Target repo (owner/name) — must be bootstrapped first:
#   theozolith-bootstrap --repo <owner/name>
THEOZOLITH_REPO=acme/sandbox

# One machine-user PAT per actor (repo scope on the target repo).
# The Worker and the Reviewer must be DIFFERENT GitHub identities:
# no self-grading by construction (ADR-0008).
WORKER_GITHUB_TOKEN=ghp_...
REVIEWER_GITHUB_TOKEN=ghp_...

# The Claude adapter's API key (both actors).
ANTHROPIC_API_KEY=sk-ant-...

# --- optional ---------------------------------------------------------------

# Models. The Reviewer's must be stronger than the Worker's (ADR-0008).
#WORKER_MODEL=claude-sonnet-5
#REVIEWER_MODEL=claude-fable-5

# Stable name for this Worker (evidence bundles, M3 heartbeats).
#WORKER_ID=worker-1

# Poll cadence for both actors, seconds.
#POLL_SECONDS=60

# Recycle the Worker container after N Runs (long-lived, never immortal).
#RECYCLE_RUNS=10

# Advisory Control Node claim pre-filter (lands in M3). Leave empty:
# GitHub-only operation is the permanent degraded mode (ADR-0002).
#CONTROL_NODE_URL=

# Optional Knowledge Source baked into the image at build time (M1 bake CLI):
# a git URL + pin of a repo of skills/subagents/workflows.
#KNOWLEDGE_SOURCE=
#KNOWLEDGE_PIN=
