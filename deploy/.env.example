# TheOzolith deployment configuration: drivers + Node Daemon + Control Node.
# Copy to .env and fill in. Any secret below may instead be provided as
# <NAME>_FILE pointing at a file on the box (the VAR_FILE convention every
# TheOzolith service honors; NODE-SUBSTRATE.md) — which is exactly how the
# Node Daemon delivers Control-Node-stored secrets from /run/theozolith/secrets.
#
# Deployment shapes:
#   full substrate — install-nodedaemon.sh on every box; the Control Node runs
#     as the `control` Stack (deploy/compose/control.yml); Stacks come from the
#     Config Repo (see deploy/configs-example/).
#   daemon-less dev — docker + the TheOzolith package + this .env, drivers run
#     by hand (`theozolith-worker --once`) against a local
#     `theozolith-control serve`. Since ADR-0017 the Control Node writes every
#     claim: there is no GitHub-only claim path.

# --- required (drivers) -------------------------------------------------------

# Target repo (owner/name) — must be bootstrapped first:
#   theozolith-bootstrap --repo <owner/name>
THEOZOLITH_REPO=acme/sandbox

# One machine-user PAT per driver (repo scope on the target repo).
# The Worker and the Reviewer must be DIFFERENT GitHub identities:
# no self-grading by construction (ADR-0008). PATs live in the drivers only;
# no run container ever sees them (ADR-0013).
WORKER_GITHUB_TOKEN=ghp_...
REVIEWER_GITHUB_TOKEN=ghp_...

# The Claude adapter's API key — the only secret run containers receive
# (a rotatable spend credential, not GitHub authority; ADR-0013).
ANTHROPIC_API_KEY=sk-ant-...

# Where every node and driver reaches the Control Node. REQUIRED for the
# drivers (ADR-0017: claims dispatch through the Control Node — with it
# unreachable, in-flight Runs finish and publish while new claims and review
# rounds pause). HTTPS + bearer token; TLS is mandatory since secrets transit
# the channel. Use the deployment's canonical origin (ADR-0019: the
# <slug>.theozolith.internal hostname minted by `theozolith-control
# origin-init` and covered by its TLS cert) — nodes must reach it by that
# exact name for cert verification to pass. `--insecure-dev` uses localhost.
CONTROL_NODE_URL=https://<slug>.theozolith.internal:8443

# --- Control Node + Node Daemon (substrate) -----------------------------------

# The two channel credentials (ADR-0015): nodes + drivers present the node
# token; the CLI and the dashboard (login form, secret entry, terminal)
# present the admin token — one admin credential, dashboard access = cluster
# access (single-operator V1 trust model).
#THEOZOLITH_NODE_TOKEN=
#THEOZOLITH_ADMIN_TOKEN=

# CA bundle pinning the Control Node's self-signed CA on nodes and drivers
# (minted by `theozolith-control tls-init`; installed by install-nodedaemon.sh).
#THEOZOLITH_TLS_CA=/etc/theozolith/ca.pem

# This node's name (Stack placement matching, heartbeats, events).
# Default: the hostname.
#THEOZOLITH_NODE_NAME=

# Control Node: the control PAT — REQUIRED for the pipeline (ADR-0017: the
# Control Node writes every claim; it also runs the evidence-first janitor).
# Read + issue writes on the target repo. Unset = pure substrate observer:
# claim dispatch answers 503 and the pipeline pauses.
#CONTROL_GITHUB_TOKEN=

# Control Node data dir (SQLite DB, master key, TLS material) and the Config
# Repo working home (ADR-0006). Containerized defaults: /data and /configs.
#THEOZOLITH_CONTROL_DATA=~/.theozolith/control
#THEOZOLITH_CONFIG_REPO=~/.theozolith/configs

# Substrate cadences and windows (ADR-0015/0017/0016 defaults shown):
# heartbeats, the zombie grace period, the janitor cadence, the dispatch
# grant activation window, the progress-telemetry byte budget (cache, never
# archive), and the kill-the-tree grace.
#THEOZOLITH_HEARTBEAT_SECONDS=60
#THEOZOLITH_ZOMBIE_GRACE_SECONDS=600
#THEOZOLITH_JANITOR_SWEEP_SECONDS=60
#THEOZOLITH_ACTIVATION_WINDOW_SECONDS=60
#THEOZOLITH_TAIL_BUDGET_BYTES=10737418240
#THEOZOLITH_STOP_GRACE_SECONDS=30

# Node Daemon working dirs (systemd sets these; override for dev only):
# state = config cache + compose files (disk), runtime = secrets (tmpfs).
#THEOZOLITH_STATE_DIR=/var/lib/theozolith
#THEOZOLITH_RUNTIME_DIR=/run/theozolith

# --- optional (drivers) --------------------------------------------------------

# The run-container image both drivers launch. Under the Node Daemon this is
# injected per Stack from the Config Repo's derived image (run_image); set it
# only for daemon-less dev. Build the dev image:
#   docker build -f worker/docker/Dockerfile.claude -t theozolith-run-claude:local .
#THEOZOLITH_RUN_IMAGE=theozolith-run-claude:local

# Models. The Reviewer's must be stronger than the Worker's (ADR-0008).
#WORKER_MODEL=claude-sonnet-5
#REVIEWER_MODEL=claude-fable-5

# Stable name for this Worker (evidence bundles, events).
#WORKER_ID=worker-1

# theozolith.owner label on containers each driver creates (its Stack name).
#WORKER_STACK=worker
#REVIEWER_STACK=reviewer

# Poll cadence for both drivers, seconds.
#POLL_SECONDS=60

# Where per-Run job directories live (bind-mounted into run containers).
# Under the Node Daemon this is injected per Stack as <base>/<stack-name>
# (ADR-0019: each process Stack owns a distinct jobs dir so queue-behind
# never sees another Stack's Runs) — set it only for daemon-less dev, and
# give each driver its own path.
#THEOZOLITH_JOBS_DIR=/var/tmp/theozolith/jobs/worker

# Agent session limits: hard timeout and the completion-hook settle window.
#THEOZOLITH_AGENT_TIMEOUT_SECONDS=3600
#THEOZOLITH_SETTLE_SECONDS=20

# Run-progress telemetry cadence (theozolith.run.progress events: phase,
# elapsed, tool-call counters, size-capped transcript tail; ADR-0016).
# 0 disables emission.
#THEOZOLITH_PROGRESS_SECONDS=30

# Warm dependency caches as named volumes (name:/container-path, comma-sep).
#THEOZOLITH_CACHE_VOLUMES=theozolith-cache:/home/ozolith/.cache

# Run containers as this uid:gid (e.g. "$(id -u):$(id -g)") so job-dir files
# stay owned by the driver user; default is the image's ozolith user (whose
# uid is the OZOLITH_UID build arg, default 1000).
#THEOZOLITH_CONTAINER_USER=

# Optional Knowledge Source baked into the image at build time (M1 bake CLI):
# a git URL + pin of a repo of skills/subagents/workflows. Under the Config
# Repo, declare it on the image instead (images/<name>.toml).
#KNOWLEDGE_SOURCE=
#KNOWLEDGE_PIN=
