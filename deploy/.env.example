# TheOzolith M2 deployment: the Worker driver + the Reviewer driver on one box.
# Copy to .env and fill in. Any secret below may instead be provided as
# <NAME>_FILE pointing at a file on the box (the VAR_FILE convention every
# TheOzolith service honors; NODE-SUBSTRATE.md).
#
# The drivers are plain host processes (no Node Daemon until M3); they create
# one ephemeral run container per Run / review round. Deployment footprint:
# docker + the TheOzolith package + this .env — nothing else (deletion test).

# --- required ---------------------------------------------------------------

# Target repo (owner/name) — must be bootstrapped first:
#   theozolith-bootstrap --repo <owner/name>
THEOZOLITH_REPO=acme/sandbox

# One machine-user PAT per driver (repo scope on the target repo).
# The Worker and the Reviewer must be DIFFERENT GitHub identities:
# no self-grading by construction (ADR-0008). PATs live in the drivers only;
# no run container ever sees them (ADR-0013).
WORKER_GITHUB_TOKEN=ghp_...
REVIEWER_GITHUB_TOKEN=ghp_...

# The Claude adapter's API key — the only secret run containers receive
# (a rotatable spend credential, not GitHub authority; ADR-0013).
ANTHROPIC_API_KEY=sk-ant-...

# --- optional ---------------------------------------------------------------

# The run-container image both drivers launch. Build it first:
#   docker build -f worker/docker/Dockerfile.claude -t theozolith-run-claude:local .
#THEOZOLITH_RUN_IMAGE=theozolith-run-claude:local

# Models. The Reviewer's must be stronger than the Worker's (ADR-0008).
#WORKER_MODEL=claude-sonnet-5
#REVIEWER_MODEL=claude-fable-5

# Stable name for this Worker (evidence bundles, M3 heartbeats).
#WORKER_ID=worker-1

# theozolith.owner label on containers each driver creates (its Stack name).
#WORKER_STACK=worker
#REVIEWER_STACK=reviewer

# Poll cadence for both drivers, seconds.
#POLL_SECONDS=60

# Where per-Run job directories live (bind-mounted into run containers).
#THEOZOLITH_JOBS_DIR=/var/tmp/theozolith/jobs

# Agent session limits: hard timeout and the completion-hook settle window.
#THEOZOLITH_AGENT_TIMEOUT_SECONDS=3600
#THEOZOLITH_SETTLE_SECONDS=20

# Warm dependency caches as named volumes (name:/container-path, comma-sep).
#THEOZOLITH_CACHE_VOLUMES=theozolith-cache:/home/ozolith/.cache

# Run containers as this uid:gid (e.g. "$(id -u):$(id -g)") so job-dir files
# stay owned by the driver user; default is the image's ozolith user (whose
# uid is the OZOLITH_UID build arg, default 1000).
#THEOZOLITH_CONTAINER_USER=

# Advisory Control Node claim pre-filter (lands in M3). Leave empty:
# GitHub-only operation is the permanent degraded mode (ADR-0002).
#CONTROL_NODE_URL=

# Optional Knowledge Source baked into the image at build time (M1 bake CLI):
# a git URL + pin of a repo of skills/subagents/workflows.
#KNOWLEDGE_SOURCE=
#KNOWLEDGE_PIN=
