POST /graphql HTTP/1.1
Host: api.github.com
User-Agent: GitHub CLI 2.100.0
Content-Length: 144
Accept: */*
Authorization: token sentinel
Content-Type: application/json; charset=utf-8
Time-Zone: UTC
