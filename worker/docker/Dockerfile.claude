# The Claude run-container image: what an Implementer or Reviewer driver
# launches for every Run and review round (ADR-0013). PID 1 is the agent
# harness — credential-free plumbing that invokes the Claude session headless
# (`claude -p`, ADR-0019), serves driver-sequenced gate jobs, and exits;
# container lifetime = Run lifetime. The driver bind-mounts the per-Run job
# directory at /job. Run containers are never attach targets.
#
# Build from the repo root:
#   docker build -f worker/docker/Dockerfile.claude \
#     [--build-arg KNOWLEDGE_SOURCE=https://…/my-knowledge.git \
#      --build-arg KNOWLEDGE_PIN=<commit-sha>] \
#     [--build-arg OZOLITH_UID=1000] \
#     -t theozolith-run-claude:local .
#
# The optional Knowledge Source is baked at BUILD time by the M1 bake CLI;
# nothing syncs or executes at container start (NODE-SUBSTRATE.md).
#
# No GitHub credential ever enters this image or its RUN containers: the
# driver holds the PAT and performs all GitHub I/O. The only secret a run
# container sees is the model credential — an API key (a rotatable spend
# credential, ADR-0013) or a `claude setup-token` OAuth token. The Flight
# Deck derives from this image and is the deliberate exception (ADR-0019):
# its containers receive their OWN no-merge machine-identity token at
# container start through the secret machinery — still never baked into
# this or any derived image.

FROM python:3.13-slim

# git: the agent inspects the checkout (the driver does all pushes).
# nodejs/npm: the Claude Code CLI, pinned EXACTLY (Dockerfile.codex parity):
# unpinned, the installed version is whatever was latest at the last
# cache-invalidating CI build — silent and unauditable under the buildx
# layer cache. Bumping this pin is the deliberate CLI update path, and the
# edit itself invalidates the cached layer. Never go below the 2.1.232
# identity floor (ClaudeAdapter.MIN_ENFORCING_CLI). No terminal
# multiplexer: sessions are headless one-shot processes (ADR-0019) —
# interactivity lives only in the Flight Deck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code@2.1.257

# gh: the agent's GitHub read client, which speaks to the driver's GitHub
# Relay over a Unix socket (ADR-0057). Pinned to ONE exact release by
# version and release-tarball sha256, verified BEFORE extraction (the
# gitleaks fail-closed precedent of ci.yml), because the relay's fixture
# corpus is captured from this exact binary — GH_VERSION must equal the
# version worker/tests/relay_fixtures/README.md names, and a bump
# regenerates the corpus (test_deploy.py holds the two equal). V1 pins
# linux_amd64 only: any other TARGETARCH fails the build rather than
# installing an unverified binary. Downloaded with the image's own
# python3, so no fetch tool joins the image.
ARG TARGETARCH
ARG GH_VERSION=2.100.0
ARG GH_SHA256=e4d4bb4498e8d007abe545b6568926793ace1b6447da598294a610018cb164be
RUN arch="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && if [ "$arch" != "amd64" ]; then \
        echo "gh ${GH_VERSION} is pinned for linux_amd64 only; ${arch} is unsupported" >&2; \
        exit 1; \
    fi \
    && cd /tmp \
    && python3 -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], "gh.tgz")' \
        "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
    && echo "${GH_SHA256}  gh.tgz" | sha256sum -c - \
    && tar -xzf gh.tgz "gh_${GH_VERSION}_linux_amd64/bin/gh" \
    && install -m 0755 "gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
    && rm -rf gh.tgz "gh_${GH_VERSION}_linux_amd64"

# The agent must not run as root (the Claude CLI refuses
# --dangerously-skip-permissions for root, and the Run needs no privileges).
# Match OZOLITH_UID to the driver user's uid so files written to the mounted
# job directory stay owned by the driver (deploy/README.md); alternatively
# launch with THEOZOLITH_CONTAINER_USER and rely on the a+rwX home below.
ARG OZOLITH_UID=1000
RUN useradd --create-home --shell /bin/bash --uid "${OZOLITH_UID}" ozolith

# Install the knowledge machinery and the worker component (for the
# theozolith-harness entrypoint) from the build context.
COPY knowledge /opt/theozolith/knowledge
COPY worker /opt/theozolith/worker
RUN pip install --no-cache-dir /opt/theozolith/knowledge /opt/theozolith/worker

# Bake the pinned Knowledge Source (skills, subagents, workflows) into the
# image's Claude config dir when one is declared.
ARG KNOWLEDGE_SOURCE=""
ARG KNOWLEDGE_PIN=""
RUN if [ -n "$KNOWLEDGE_SOURCE" ]; then \
        theozolith-knowledge bake \
            --source "$KNOWLEDGE_SOURCE" \
            --pin "$KNOWLEDGE_PIN" \
            --target /home/ozolith/.claude \
        && chown -R ozolith:ozolith /home/ozolith/.claude; \
    fi

# Keep the home usable when the driver overrides the container user to its
# own uid (THEOZOLITH_CONTAINER_USER): the CLI reads and writes ~/.claude.
RUN chmod -R a+rwX /home/ozolith

USER ozolith
ENV HOME=/home/ozolith
WORKDIR /job

ENTRYPOINT ["theozolith-harness"]
